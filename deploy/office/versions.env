# Office engines and browser editors – pinned upstream releases (MIT OR Apache-2.0, see THIRD-PARTY.md).
# Read by install.sh and the Dockerfile. The sha256 values are copied from each release's SHA256SUMS.txt (checked 2026-10-09);
# when you change a version, take the new values from that release's SHA256SUMS.txt – install.sh refuses a file that does not match.
# An empty checksum stops the install (no unchecked downloads), unless OFFICE_ALLOW_UNPINNED=1.

OFFICE_GITHUB="${OFFICE_GITHUB:-https://github.com}"

# Dokumente (.docx)
OFFICE_DOCX_REPO=storytold/wordcraft
OFFICE_DOCX_NAME=wordcraft
OFFICE_DOCX_VERSION=0.3.0
