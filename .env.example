# HyperLevel configuration. Copy to .env and adjust (scripts/install.sh writes it for you).
# Only PGHL_BASE_URL is really needed; everything else has a sensible default or can be set in the UI.
# Never commit the filled-in .env.

# --- Basics ------------------------------------------------------------------------------------------
# Public address – used in every link HyperLevel sends (bookings, invoices, reviews, unsubscribe, webhooks).
PGHL_BASE_URL=https://crm.example.com
# Domain for the bundled Caddy (docker compose --profile caddy) and the Traefik example.
PGHL_DOMAIN=crm.example.com
# Time zone of the first sub-account and of the demo reset.
PGHL_TIMEZONE=Europe/Berlin

# --- First start -------------------------------------------------------------------------------------
# Creates the admin and a first sub-account on the very first start. Leave empty to use the setup page
# in the browser instead (shown until the first account exists; POST /api/auth/setup).
PGHL_ADMIN_EMAIL=
PGHL_ADMIN_PASSWORD=
# PGHL_ADMIN_NAME=
PGHL_COMPANY_NAME=My Company

# --- Server ------------------------------------------------------------------------------------------
# Data folder: SQLite database, uploads, backups, the generated secret. Docker: /data (volume).
# PGHL_DATA_DIR=./data
# Port (PORT or PGHL_PORT, default 4700) and listen address (default 127.0.0.1, or 0.0.0.0 with PGHL_BEHIND_PROXY=1).
# PORT=4700
# PGHL_PORT=4700
# PGHL_HOST=127.0.0.1
# Behind a reverse proxy (Caddy, Traefik, nginx): listen on 0.0.0.0 and trust X-Forwarded-For. Set in Docker.
# PGHL_BEHIND_PROXY=1
# Signs sessions, unsubscribe links and encrypts stored credentials (AES-256-GCM). Default: generated
# once into <data>/secret. If you set it, keep it forever – changing it makes stored credentials unreadable.
# PGHL_SECRET=
# Proxies that append to X-Forwarded-For (1 = Traefik/Caddy alone, 2 = Cloudflare in front).
# PGHL_PROXY_HOPS=1
# Key for stored credentials (64 hex chars); default: data/data.key from `npm run rotate-secret`.
# PGHL_DATA_KEY=
# PGHL_DATA_KEY_PREVIOUS=
# Only for LAN-only installs: allow webhooks, iCal, the SMS gateway and SSO providers in the Docker network to reach
# internal addresses (off: protects against SSRF).
# PGHL_ALLOW_PRIVATE_FETCH=1
# Emergency access: admins may sign in with a password again despite a SSO/2FA requirement. Set only temporarily (docs/auth.md).
# PGHL_AUTH_BREAK_GLASS=1
# Scheduler tick for workflow waits, reminders, scheduled campaigns, syncs (milliseconds; 0 = off).
# PGHL_TICK_MS=15000
# Built web app (only change for custom layouts).
# PGHL_WEB_DIR=./dist-web
# Version shown in bug-report diagnostics (default: "version" of package.json) and a build id appended as +<build>.
# PGHL_VERSION=
# PGHL_BUILD=

# --- Performance (docs/performance.md) ---------------------------------------------------------------
# Requests slower than this many ms are logged with their route and listed under Agentur -> System (0 = off).
# PGHL_SLOW_REQUEST_MS=300
# Time every SQL statement and log the slow ones (no values) – for investigating, costs a few percent.
# PGHL_SLOW_QUERY_MS=50
# SQLite page cache and memory-mapped part of the database file, in MB (mmap 0 = off; set it to your database size).
# PGHL_SQLITE_CACHE_MB=32
# PGHL_SQLITE_MMAP_MB=256
# 0 = no read cache for dashboards/lists (default: cached until the next write).
# PGHL_RESULT_CACHE=1

# --- Backups -----------------------------------------------------------------------------------------
# Daily SQLite backup to <data>/backups (set 0 to turn off) and how many to keep.
# PGHL_BACKUPS=1
# PGHL_BACKUP_KEEP=14
# Off-site encrypted backups to S3-compatible storage (hourly, 48/14/6 kept, monthly restore test) – docs/backups.md.
# PGHL_BACKUP_S3_ENDPOINT=https://fsn1.your-objectstorage.com
# PGHL_BACKUP_S3_BUCKET=
# PGHL_BACKUP_S3_REGION=fsn1
# PGHL_BACKUP_S3_ACCESS_KEY=
# PGHL_BACKUP_S3_SECRET_KEY=
# PGHL_BACKUP_S3_PREFIX=
# PGHL_BACKUP_S3_PATH_STYLE=1
# 32 bytes (openssl rand -hex 32) – keep a copy apart from the server, backups are useless without it.
# PGHL_BACKUP_KEY=
# PGHL_BACKUP_KEY_PREVIOUS=
# PGHL_BACKUP_INTERVAL_MIN=60
# PGHL_BACKUP_RETENTION=48,14,6
# PGHL_BACKUP_FILES=1
# PGHL_BACKUP_PING_URL=https://hc-ping.com/<uuid>
# Alerts (disk < 10 %, backup too old, scheduler stalled, error spike): e-mail (default: every admin), web push, webhook.
# PGHL_ALERT_EMAIL=ops@example.com
# PGHL_ALERT_WEBHOOK=https://ntfy.sh/my-topic
# PGHL_ALERT_PUSH=1
# Public status page /status (default: on in cloud mode).
# PGHL_STATUS_PAGE=1

# --- Demo mode (public try-it-out instance) ------------------------------------------------------------
# Seeds fictional data into an EMPTY data folder, resets it every night, blocks every outgoing connection
# (e-mail, SMS, WhatsApp, social, payments, webhooks, AI) and shows the demo login. See docs/demo-mode.md.
# PGHL_DEMO_MODE=1
# PGHL_DEMO_EMAIL=demo@example.com
# PGHL_DEMO_PASSWORD=demo1234
# Local hours (PGHL_TIMEZONE) after which a reset runs – several a day, comma-separated; or one hour with PGHL_DEMO_RESET_HOUR.
# PGHL_DEMO_RESET_HOURS=3,11,19
# PGHL_DEMO_RESET_HOUR=3
# Product name the demo shows ("<name> Demo" in the menu, "<name> – Live-Demo" on the login page).
# PGHL_DEMO_BRAND=HyperLevel

# --- Courses and forms (docs/courses.md, docs/forms.md) ----------------------------------------------
# Largest course video upload in MB, and how long a member's signed video links stay valid (minutes).
# PGHL_COURSE_VIDEO_MB=2048
# PGHL_COURSE_URL_TTL_MIN=360
# ffmpeg is optional (poster frame, HLS, AI captions); it is found on its own. 1 = transcode every upload to HLS.
# PGHL_COURSE_HLS=1
# PGHL_FFMPEG=ffmpeg
# PGHL_FFPROBE=ffprobe
# PGHL_COURSE_NO_FFMPEG=1
# Form submissions per minute and address (spam brake).
# PGHL_FORMS_PER_MINUTE=20
# Disk space for files visitors upload through public forms, per sub-account in MB (0 = no cap of its own; the cloud plan's
# media storage counts as well). Above it a submission with a file is refused with 413; the team is told at 90 % and 100 %.
# PGHL_PUBLIC_UPLOADS_MB=2048
# Disk space for video testimonials customers send through the collect page, per sub-account in MB (0 = no cap of its own; the
# cloud plan's media storage counts as well). Above it the collect page refuses new videos with 413.
# PGHL_TESTIMONIALS_MB=2048
# Websites (docs/sites.md): switch off the optional image engine (sharp, used when installed).
# PGHL_IMAGE_ENGINE=off
# AI Studio (docs/ai-studio.md#publish): a host of its own for published apps (point its DNS here; only /apps/<slug>/ answers there).
# PGHL_APPS_ORIGIN=https://apps.example.com

# --- Optional integrations (all of these can also be set in the UI) ----------------------------------
# Anthropic key for the AI assistant of all sub-accounts without their own key (monthly limit per sub-account).
# PGHL_ANTHROPIC_API_KEY=
# OpenAI key for sub-accounts that use OpenAI without their own or an agency key (docs/ai-assistant.md).
# PGHL_OPENAI_API_KEY=
# Composio key of the agency instead of Agentur → Integrationen → Einrichtung (docs/connectors.md).
# PGHL_COMPOSIO_API_KEY=
# KI-Studio (docs/genmedia.md): largest result kept per kind in MB (default 30 / 200 / 60) and minutes before a job gives up.
# PGHL_GENMEDIA_MAX_IMAGE_MB=30
# PGHL_GENMEDIA_MAX_VIDEO_MB=200
# PGHL_GENMEDIA_MAX_AUDIO_MB=60
# PGHL_GENMEDIA_TIMEOUT_MIN=
# Google OAuth app (calendar sync, Business Profile) – otherwise Agentur → Integrationen → Einrichtung.
# PGHL_GOOGLE_CLIENT_ID=
# PGHL_GOOGLE_CLIENT_SECRET=
# Microsoft Entra app (Outlook calendar); tenant default "common".
# PGHL_MS_CLIENT_ID=
# PGHL_MS_CLIENT_SECRET=
# PGHL_MS_TENANT=common
# Pub/Sub topic for Gmail push (docs/mailbox-sync.md); polling is used without it.
# PGHL_GMAIL_PUBSUB_TOPIC=projects/my-project/topics/gmail-push
# Meta app and Google Ads access of the agency for the ads manager (docs/ads-manager.md); saved values in the UI win.
# PGHL_META_APP_ID=
# PGHL_META_APP_SECRET=
# PGHL_GOOGLE_ADS_DEVELOPER_TOKEN=
# PGHL_GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# Self-hosted Postiz for the Social Planner.
# PGHL_POSTIZ_URL=https://postiz.example.com
# PGHL_POSTIZ_KEY=
# Nango instead of Agentur → Integrationen → Nango (docs/nango.md); without a URL Nango Cloud is used.
# PGHL_NANGO_URL=https://api.nango.dev
# PGHL_NANGO_SECRET_KEY=
# PGHL_NANGO_WEBHOOK_KEY=
# PGHL_NANGO_CONNECT_URL=
# PGHL_NANGO_ALLOW_PRIVATE=1     # Nango in the same Docker network (http://nango-server:3003)
# OpenShorts for the Video-Studio (with the compose profile: http://openshorts:8000).
# PGHL_OPENSHORTS_URL=http://openshorts:8000
# PGHL_OPENSHORTS_KEY=
# Office (docs/office.md): optional browser editors (one folder per kind: docx/ xlsx/ pptx/ pdf/) and headless engines,
# installed with deploy/office/install.sh or the image of deploy/office/. Without them: files, versions, comments, plain-text reading.
# PGHL_OFFICE_DIR=/opt/office/web
# PGHL_OFFICE_BIN_DIR=/opt/office/bin
# PGHL_OFFICE_SANDBOX=strict     # same-origin only if an editor will not start without its own storage
# PGHL_OFFICE_MAX_MB=25          # largest file (each version)
# PGHL_OFFICE_QUOTA_MB=2048      # all versions of a sub-account, 0 = no cap
# Project files (Claude project instructions, knowledge files, repo files over MCP) – docs/ai-tools.md#project-files
# PGHL_PROJECT_FILES_MB=1024     # per sub-account, 0 = no cap of its own
# Documents on contacts and note attachments (docs/sales.md#crm-housekeeping)
# PGHL_CONTACT_DOCS_MB=2048      # per sub-account, 0 = no cap
# Largest webinar video upload in MB (default 4096).
# PGHL_WEBINAR_MAX_MB=4096
# Largest export file the Umzug assistant accepts, in MB (1-500).
# PGHL_UMZUG_MAX_MB=50
# Contact address in Web Push headers (mailto: or https URL; default: the first admin's e-mail). Push needs HTTPS (PGHL_BASE_URL).
# PGHL_PUSH_CONTACT=mailto:admin@example.com
# Native app push (docs/apps.md): relay (default, via the operator's relay) | own (own FCM/APNs keys) | off
# PGHL_PUSH_MODE=relay
# PGHL_PUSH_RELAY_URL=https://gohyperlevel.com
# PGHL_FCM_SERVICE_ACCOUNT=/run/secrets/fcm-service-account.json
# PGHL_APNS_KEY=/run/secrets/AuthKey.p8
# PGHL_APNS_KEY_ID=
# PGHL_APNS_TEAM_ID=
# PGHL_APNS_TOPIC=com.example.app
# PGHL_APNS_SANDBOX=0
# Operator's cloud instance only: push relay for the gray-label app and the instance directory
# PGHL_PUSH_RELAY=0
# PGHL_PUSH_RELAY_RATE=600
# PGHL_APP_DIRECTORY=0

# --- Hosted cloud version (docs/cloud.md) --------------------------------------------------------------
# Sign up, pay and work on THIS instance: /cloud (prices), /start (signup), Agentur → Cloud (console).
# Needs PGHL_BASE_URL (public https) and a Stripe account of yours (key + webhook secret, see docs/cloud.md).
# PGHL_CLOUD_MODE=1
# Customers get <name>.<domain> (DNS *.<domain> → this server); empty = everyone uses PGHL_BASE_URL.
# PGHL_CLOUD_DOMAIN=cloud.example.com
# Customers' websites on a domain of their own (<slug>.<domain>, DNS *.<domain> → this server), never on the login domain.
# PGHL_CLOUD_SITES_DOMAIN=example-sites.net
# Free trial in days (0–90) and whether Stripe asks for a card at signup (1/0). Both editable in the console.
# PGHL_CLOUD_TRIAL_DAYS=14
# PGHL_CLOUD_CARD_REQUIRED=1
# Stripe keys can also be entered in the UI (Agentur → SaaS → Einstellungen); these seed them once when none is set.
# PGHL_CLOUD_STRIPE_SECRET_KEY=
# PGHL_CLOUD_STRIPE_WEBHOOK_SECRET=
# Waitlist instead of signup (docs/cloud.md#waitlist-mode): nobody can sign up or pay, /cloud, /start and the landing page
# show self-hosting and a waitlist form. Empty = on while the cloud mode has no Stripe key; 1 = always on (also on the
# landing page without cloud mode); 0 = off.
# PGHL_CLOUD_WAITLIST=
# The operator's own HQ sub-account: every customer account shows up there as a contact + deal (docs/cloud.md).
# PGHL_HQ_LOCATION=

# --- Landing page waitlist (docs/company-playbook.md) ----------------------------------------------------
# Sub-account (and optionally the form id) that POST /api/public/landing/waitlist posts into; empty = off.
# PGHL_LANDING_LOCATION=
# PGHL_LANDING_FORM=

# --- Public landing page (docs/landing.md) -------------------------------------------------------------
# The project's own start page on this instance's address: / (English), /de, /vergleich, /vergleich/highlevel,
# /sitemap.xml. Other hosts (client login domains, cloud sub-domains) keep the app. Off by default (/ = the web app).
# PGHL_LANDING=1
# More hosts that show it (comma-separated); PGHL_BASE_URL's host and its www twin always do.
# PGHL_LANDING_HOSTS=gohyperlevel.de
# Legal notice and privacy policy links when the cloud mode is off (with it, /cloud/legal/… is linked).
# PGHL_LANDING_IMPRESSUM_URL=https://example.com/impressum
# PGHL_LANDING_PRIVACY_URL=https://example.com/datenschutz

# --- Android app (App Links) ---------------------------------------------------------------------------
# Package name and SHA-256 fingerprint(s) of YOUR signed build for /.well-known/assetlinks.json.
# Without a fingerprint App Links stay off (links open in the browser). See android/README.md.
# PGHL_ANDROID_PACKAGE=org.gohigh.android
# PGHL_ANDROID_CERT_SHA256=AB:CD:…

# --- Custom domains via the nginx domain agent (deploy/examples/nginx-domain-agent) --------------------
# PGHL_AGENT_TOKEN=
# PGHL_SERVER_IP=203.0.113.10

# --- Docker Compose (docker-compose.yml) ---------------------------------------------------------------
# Prebuilt image to use instead of a local build (docker compose pull gohigh), e.g. a pinned version.
# GOHIGH_IMAGE=ghcr.io/baisesystems/hyperlevel:latest
# Host address/port the app is published on (default 127.0.0.1:4700 – Caddy does the public side).
# GOHIGH_BIND=127.0.0.1
# GOHIGH_PORT=4700
# Nango profile (docker compose --profile nango, deploy/nango/README.md). Elastic License 2.0 – see docs/nango.md.
# NANGO_ENCRYPTION_KEY=          # openssl rand -base64 32 – never change it afterwards
# NANGO_DB_PASSWORD=
# NANGO_DASHBOARD_PASSWORD=
# NANGO_SERVER_URL=https://nango.example.com          # public URL (OAuth callback: <url>/oauth/callback)
# NANGO_PUBLIC_CONNECT_URL=https://connect.nango.example.com
# OpenShorts profile: GEMINI_API_KEY or an OpenAI-compatible LLM_BASE_URL/LLM_MODEL/LLM_API_KEY, resources.
# GEMINI_API_KEY=
# OPENSHORTS_CPUS=3
# OPENSHORTS_MEMORY=6g

# "Konto anlegen" links next to provider key fields (docs/referrals.md).
# Some are referral links of the maintainer (labelled "Partner-Link"). Switch them all off:
# PGHL_REFERRALS_DISABLED=1
# …or use your own (JSON map, "" = plain sign-up page; Agentur → Partner-Links wins):
# PGHL_REFERRALS={"kie":"https://kie.ai/?ref=me","stripe":""}

# Werkstatt / plugins (docs/werkstatt.md#configuration). Plugin scripts run in a permission-restricted child process;
# PGHL_PLUGIN_NETNS=off turns off the extra network namespace. Automatic Marktplatz screenshots are off unless both are set:
# PGHL_PLUGIN_SCREENSHOTS=1
# PGHL_CHROMIUM=/usr/bin/chromium
# PGHL_CHROMIUM_NO_SANDBOX=1     # only in a disposable container without user namespaces
# Signed plugin bundles: this installation signs its exports with a PKCS#8 PEM key (\n allowed) and trusts it; more publishers as JSON.
# PGHL_PLUGIN_SIGNING_KEY=
# PGHL_PLUGIN_SIGNING_KEY_ID=
# PGHL_PLUGIN_TRUSTED_KEYS=[{"id":"partner","label":"Partner","public_key":"…"}]

# Community (docs/community.md). All optional.
# Turn the public directory /communities off for the whole server:
# PGHL_COMMUNITY_DISCOVERY=0
# Largest video a member can upload to a post, in MB (default 500):
# PGHL_COMMUNITY_VIDEO_MB=500
# Jitsi Meet server for live calls (default: the public https://meet.jit.si; no path, no credentials):
# PGHL_JITSI_URL=https://meet.example.com

# --- Abo-Anmeldung ("Mit ChatGPT anmelden", see docs/ai-providers.md) -----------------------------------
# Switch the whole subscription sign-in off for this server.
# PGHL_SUBSCRIPTION_SIGNIN=off
# This installation is run as a hosted/paid service for other people: "Mit ChatGPT anmelden" stays off until OpenAI has approved it
# (interest form: https://openai.com/form/sign-in-with-chatgpt-interest/) and you set the second variable.
# PGHL_HOSTED=1
# PGHL_CHATGPT_SIGNIN_APPROVED=1
