# Copy to .env next to docker-compose.yml (never commit the filled-in file).

# HyperLevel's Docker network (docker network ls) – HyperLevel reaches OpenShorts as http://openshorts:8000
GOHIGH_NETWORK=gohigh_default

# Moment picker: a free Gemini key from https://aistudio.google.com/app/apikey …
GEMINI_API_KEY=
# … or an OpenAI-compatible server instead (Ollama, vLLM, OpenRouter, Anthropic's OpenAI-compatible API).
# Automatic layout and silent videos still need Gemini.
# LLM_BASE_URL=https://api.anthropic.com/v1
# LLM_MODEL=claude-haiku-4-5
# LLM_API_KEY=sk-ant-...

# Resources (the CRM keeps the rest of the machine)
OPENSHORTS_CPUS=3
OPENSHORTS_MEMORY=6g

# Transcription model on CPU: base (fast) · small (default) · medium (exact, slow)
WHISPER_MODEL=small

# Keep finished jobs 7 days (HyperLevel streams the clips from OpenShorts), cap the disk
JOB_RETENTION_SECONDS=604800
OUTPUT_MAX_GB=20
UPLOADS_MAX_GB=10

# Pin the upstream version for reproducible builds
# OPENSHORTS_GIT=https://github.com/mutonby/openshorts.git#06a119c
