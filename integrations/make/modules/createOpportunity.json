{
  "name": "createOpportunity",
  "label": "Opportunity anlegen",
  "description": "Legt einen Deal für einen Kontakt an.",
  "type": "action",
  "typeId": 4,
  "connection": "gohigh",
  "communication": {
    "url": "/api/hooks/actions/create_opportunity",
    "method": "POST",
    "body": "{{parameters}}",
    "response": {
      "output": "{{body}}"
    }
  },
  "parameters": [],
  "expect": [
    {
      "name": "contact_id",
      "label": "Kontakt-ID",
      "required": false,
      "help": "Oder E-Mail/Telefon angeben",
      "type": "text"
    },
    {
      "name": "email",
      "label": "E-Mail",
      "required": false,
      "type": "text"
    },
    {
      "name": "phone",
      "label": "Telefon",
      "required": false,
      "type": "text"
    },
    {
      "name": "first_name",
      "label": "Vorname (falls neu)",
      "required": false,
      "type": "text"
    },
    {
      "name": "last_name",
      "label": "Nachname (falls neu)",
      "required": false,
      "type": "text"
    },
    {
      "name": "pipeline",
      "label": "Pipeline",
      "required": false,
      "type": "select",
      "options": "rpc://listPipelines",
      "mode": "edit"
    },
    {
      "name": "stage",
      "label": "Stufe",
      "required": false,
      "help": "ID oder Name der Stufe",
      "type": "select",
      "options": "rpc://listStages",
      "mode": "edit"
    },
    {
      "name": "name",
      "label": "Name",
      "required": false,
      "type": "text"
    },
    {
      "name": "value",
      "label": "Wert (€)",
      "required": false,
      "type": "number"
    },
    {
      "name": "status",
      "label": "Status",
      "required": false,
      "type": "select",
      "options": [
        {
          "label": "Offen",
          "value": "open"
        },
        {
          "label": "Gewonnen",
          "value": "won"
        },
        {
          "label": "Verloren",
          "value": "lost"
        },
        {
          "label": "Aufgegeben",
          "value": "abandoned"
        }
      ]
    }
  ],
  "interface": [
    {
      "name": "id",
      "type": "text",
      "label": "ID"
    }
  ],
  "samples": {
    "id": "create_opportunity_1"
  }
}
